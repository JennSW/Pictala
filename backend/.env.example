# Copy this file to .env and fill in your own credentials.
# Nothing in this app is multi-tenant -- it's built to hold ONE person's keys.

# eBird: get a key at https://ebird.org/api/keygen (instant, tied to your account)
EBIRD_API_KEY=

# Flickr: create an app at https://www.flickr.com/services/apps/create/
# Then run `python -m app.services.flickr_oauth_setup` once to get the
# access token + secret via a one-time OAuth 1.0a flow.
FLICKR_API_KEY=
FLICKR_API_SECRET=
FLICKR_OAUTH_TOKEN=
FLICKR_OAUTH_TOKEN_SECRET=
FLICKR_USER_ID=

# Optional: Strategy B, AI-assisted species suggestions for uncaptioned
# photos. Get a key at https://console.anthropic.com (Settings > API Keys).
# The app works fine without this -- "Suggest species" just won't appear.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local SQLite file, created automatically on first run.
DATABASE_URL=sqlite:///./birdtrip.db
